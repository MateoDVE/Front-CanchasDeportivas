{
  "name": "front-canchas-deportivas",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e:pw": "playwright test",
    "test:e2e:reservas": "playwright test --grep @reservas",
    "test:e2e:reservas:formularios": "playwright test e2e/reservas-formularios.spec.ts",
    "test:e2e:reservas:estados": "playwright test e2e/reservas-estados.spec.ts",
    "test:e2e:pw:ui": "playwright test --ui",
    "test:e2e:pw:report": "playwright show-report",
    "test:e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "test:e2e:summary": "node e2e/summarize.mjs",
    "serve:ssr:FrontCanchasDeportivas": "node dist/FrontCanchasDeportivas/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.9",
    "@tailwindcss/postcss": "^4.3.3",
    "express": "^5.1.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.9",
    "@angular/cli": "^20.3.9",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
