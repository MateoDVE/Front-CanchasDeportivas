    INC ---|"1..1"| I["INCIDENTE<br/>id, inicio, fin, motivo"]
    CAN ---|"0..N"| REC{recibe}
    REC ---|"1..1"| R["RESERVA<br/>fecha, inicio, fin, precio histórico<br/>total, anticipo, estado, origen, expiración"]
    RID(["id_reserva · identificador"])
    RID --- R
    CLI ---|"0..N"| SOL{solicita}
    SOL ---|"1..1"| R
    U ---|"0..N"| CRE{crea}
