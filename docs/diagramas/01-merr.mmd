    class U,CLI,SEC,ADM,C,CAN,T,H,I,R,P,CS,E entity;
    class CONT,CLA,HOR,INC,REC,SOL,CRE,REP,IMP,ORI,PRO,AUT,CAJ,HIS,ACT,REL relation;

