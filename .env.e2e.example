# Usar frontend y backend reales; levantar ambos antes de ejecutar.
E2E_BASE_URL=http://localhost:4200
E2E_API_URL=http://localhost:3000/api/v1
# chrome o msedge instalado. Para Chromium descargado: quitar channel del config.
E2E_CHANNEL=chrome
# Confirmación explícita de ejecución contra el entorno elegido (crea datos EC3).
E2E_RUN=true
